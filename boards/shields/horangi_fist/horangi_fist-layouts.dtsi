            , <&key_physical_attrs 100 100  982  255        0  1032   305>   // RC(2,8 ) R SW7
            , <&key_physical_attrs 100 100 1082  242        0  1132   292>   // RC(2,9 ) R SW13
            , <&key_physical_attrs 100 100 1182  211        0  1232   261>   // RC(2,10) R SW19
            , <&key_physical_attrs 100 100 1299  243      450  1349   293>   // RC(2,11) R SW25
            , <&key_physical_attrs 100 100 1410  310      900  1460   360>   // RC(2,12) R SW31
            , <&key_physical_attrs 100 100 1509  325      900  1559   375>   // RC(2,13) R SW37

        // --- matrix row 3 ---
            , <&key_physical_attrs 100 100   49  424   (-900)    99   474>   // RC(3,0 ) L SW38
            , <&key_physical_attrs 100 100  148  408   (-900)   198   458>   // RC(3,1 ) L SW32
            , <&key_physical_attrs 100 100  250  343   (-450)   300   393>   // RC(3,2 ) L SW26
            , <&key_physical_attrs 100 100  360  311        0   410   361>   // RC(3,3 ) L SW20
            , <&key_physical_attrs 100 100  460  342        0   510   392>   // RC(3,4 ) L SW14
            , <&key_physical_attrs 100 100  560  355        0   610   405>   // RC(3,5 ) L SW8
            , <&key_physical_attrs 100 100  671  361        0   721   411>   // RC(3,6 ) L SW2
            , <&key_physical_attrs 100 100  871  361        0   921   411>   // RC(3,7 ) R SW2
            , <&key_physical_attrs 100 100  982  355        0  1032   405>   // RC(3,8 ) R SW8
            , <&key_physical_attrs 100 100 1082  342        0  1132   392>   // RC(3,9 ) R SW14
            , <&key_physical_attrs 100 100 1182  311        0  1232   361>   // RC(3,10) R SW20
            , <&key_physical_attrs 100 100 1292  343      450  1342   393>   // RC(3,11) R SW26
            , <&key_physical_attrs 100 100 1394  408      900  1444   458>   // RC(3,12) R SW32
