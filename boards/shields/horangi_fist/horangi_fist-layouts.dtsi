        // --- matrix row 4 ---
            , <&key_physical_attrs 100 100   65  523   (-900)   115   573>   // RC(4,0 ) L SW39
            , <&key_physical_attrs 100 100  163  507   (-900)   213   557>   // RC(4,1 ) L SW33
            , <&key_physical_attrs 100 100  258  443   (-450)   308   493>   // RC(4,2 ) L SW27
            , <&key_physical_attrs 100 100  360  411        0   410   461>   // RC(4,3 ) L SW21
            , <&key_physical_attrs 100 100  460  442        0   510   492>   // RC(4,4 ) L SW15
            , <&key_physical_attrs 100 100  560  455        0   610   505>   // RC(4,5 ) L SW9
            , <&key_physical_attrs 100 100  671  461        0   721   511>   // RC(4,6 ) L SW3
            , <&key_physical_attrs 100 100  871  461        0   921   511>   // RC(4,7 ) R SW3
            , <&key_physical_attrs 100 100  982  455        0  1032   505>   // RC(4,8 ) R SW9
            , <&key_physical_attrs 100 100 1082  442        0  1132   492>   // RC(4,9 ) R SW15
            , <&key_physical_attrs 100 100 1182  411        0  1232   461>   // RC(4,10) R SW21
            , <&key_physical_attrs 100 100 1284  443      450  1334   493>   // RC(4,11) R SW27
            , <&key_physical_attrs 100 100 1379  507      900  1429   557>   // RC(4,12) R SW33
            , <&key_physical_attrs 100 100 1477  523      900  1527   573>   // RC(4,13) R SW39

        // --- matrix row 5 ---
            , <&key_physical_attrs 100 100  360  542        0   410   592>   // RC(5,3 ) L SW22
            , <&key_physical_attrs 100 100  460  542        0   510   592>   // RC(5,4 ) L SW16
            , <&key_physical_attrs 100 100  577  573     2400   627   623>   // RC(5,5 ) L SW10
            , <&key_physical_attrs 100 100  664  623     2400   714   673>   // RC(5,6 ) L SW4
            , <&key_physical_attrs 100 100  878  623  (-2400)   928   673>   // RC(5,7 ) R SW4
            , <&key_physical_attrs 100 100  965  573  (-2400)  1015   623>   // RC(5,8 ) R SW10
            , <&key_physical_attrs 100 100 1082  542        0  1132   592>   // RC(5,9 ) R SW16
            , <&key_physical_attrs 100 100 1182  542        0  1232   592>   // RC(5,10) R SW22
            , <&key_physical_attrs 100 100  260  642        0   310   692>   // RC(5,0 ) L SW40
            , <&key_physical_attrs 100 100  360  642        0   410   692>   // RC(5,1 ) L SW34
            , <&key_physical_attrs 100 100  460  642        0   510   692>   // RC(5,2 ) L SW28
            , <&key_physical_attrs 100 100 1082  642        0  1132   692>   // RC(5,11) R SW28
            , <&key_physical_attrs 100 100 1182  642        0  1232   692>   // RC(5,12) R SW34
            , <&key_physical_attrs 100 100 1282  642        0  1332   692>   // RC(5,13) R SW40
            ;
    };
