/*
 * horangi_fist 물리 레이아웃 (ZMK Studio 용)
 *
 * Horangi/horangi_fist_v2/horangi_fist.kicad_pcb 의 실제 스위치 좌표에서 생성했습니다.
 * 컬럼 피치 18mm = 1u(100). x/y 는 키캡 좌상단, rx/ry 는 키 중심(절대 좌표).
 * 회전은 centi-degree, 시계방향이 양수 (KiCad 는 반시계가 양수라 부호가 반대).
 *
 * 하나의 리버서블 PCB 를 양쪽에 쓰고, 왼쪽 반은 nice!nano 가 뒤집혀 실장됩니다.
 * 그래서 왼쪽은 컬럼 순서가 반대이고(firmware col c -> PCB COL 6-c),
 * 좌표는 도면의 x 미러, 회전 부호도 반대입니다.
 *
 * ★ 불변식: 이 keys 배열의 길이 = horangi_fist.dtsi 의 matrix transform map 길이
 *          = 각 레이어의 bindings 개수 = 80.
 *   빌드 타임에 이걸 검사하는 장치가 없습니다. 한쪽만 고치면 조용히 어긋납니다.
 *   키를 추가/삭제하면 세 곳을 반드시 같이 고치세요.
 *
 * 순서는 horangi_fist.dtsi 의 map 과 동일합니다.
 */

#include <physical_layouts.dtsi>

/ {
    horangi_fist_layout: horangi_fist_layout {
        compatible = "zmk,physical-layout";
        display-name = "horangi_fist";

        keys  //                     w   h    x    y      rot    rx    ry
            = <&key_physical_attrs 100 100    0  117   (-900)    50   167>   // RC(0,0 ) L SW35
            , <&key_physical_attrs 100 100   99  101   (-900)   149   151>   // RC(0,1 ) L SW29
            , <&key_physical_attrs 100 100  226   33   (-450)   276    83>   // RC(0,2 ) L SW23
            , <&key_physical_attrs 100 100  360    0        0   410    50>   // RC(0,3 ) L SW17
            , <&key_physical_attrs 100 100  460   30        0   510    80>   // RC(0,4 ) L SW11
            , <&key_physical_attrs 100 100  560   44        0   610    94>   // RC(0,5 ) L SW5
            , <&key_physical_attrs 100 100  982   44        0  1032    94>   // RC(0,8 ) R SW5
            , <&key_physical_attrs 100 100 1082   30        0  1132    80>   // RC(0,9 ) R SW11
            , <&key_physical_attrs 100 100 1182    0        0  1232    50>   // RC(0,10) R SW17
            , <&key_physical_attrs 100 100 1316   33      450  1366    83>   // RC(0,11) R SW23
            , <&key_physical_attrs 100 100 1443  101      900  1493   151>   // RC(0,12) R SW29
            , <&key_physical_attrs 100 100 1542  117      900  1592   167>   // RC(0,13) R SW35

        // --- matrix row 1 ---
            , <&key_physical_attrs 100 100   18  226   (-900)    68   276>   // RC(1,0 ) L SW36
            , <&key_physical_attrs 100 100  116  211   (-900)   166   261>   // RC(1,1 ) L SW30
            , <&key_physical_attrs 100 100  235  144   (-450)   285   194>   // RC(1,2 ) L SW24
            , <&key_physical_attrs 100 100  360  111        0   410   161>   // RC(1,3 ) L SW18
            , <&key_physical_attrs 100 100  460  142        0   510   192>   // RC(1,4 ) L SW12
            , <&key_physical_attrs 100 100  560  155        0   610   205>   // RC(1,5 ) L SW6
            , <&key_physical_attrs 100 100  982  155        0  1032   205>   // RC(1,8 ) R SW6
            , <&key_physical_attrs 100 100 1082  142        0  1132   192>   // RC(1,9 ) R SW12
            , <&key_physical_attrs 100 100 1182  111        0  1232   161>   // RC(1,10) R SW18
            , <&key_physical_attrs 100 100 1307  144      450  1357   194>   // RC(1,11) R SW24
            , <&key_physical_attrs 100 100 1426  211      900  1476   261>   // RC(1,12) R SW30
            , <&key_physical_attrs 100 100 1524  226      900  1574   276>   // RC(1,13) R SW36

        // --- matrix row 2 ---
            , <&key_physical_attrs 100 100   33  325   (-900)    83   375>   // RC(2,0 ) L SW37
            , <&key_physical_attrs 100 100  132  310   (-900)   182   360>   // RC(2,1 ) L SW31
            , <&key_physical_attrs 100 100  243  243   (-450)   293   293>   // RC(2,2 ) L SW25
            , <&key_physical_attrs 100 100  360  211        0   410   261>   // RC(2,3 ) L SW19
            , <&key_physical_attrs 100 100  460  242        0   510   292>   // RC(2,4 ) L SW13
