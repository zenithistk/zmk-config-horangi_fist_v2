#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

&mt {
    tapping-term-ms = <175>;
};

&lt {
    tapping-term-ms = <175>;
};

/
{

    behaviors {
        gresc: grave_escape {
            compatible = "zmk,behavior-mod-morph";
            display-name = "Grave/Escape";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp GRAVE>;
            mods = <(MOD_LGUI|MOD_LSFT|MOD_RGUI|MOD_RSFT|MOD_RALT)>;
            keep-mods = <(MOD_RSFT)>;
        };
        ht_tp: holdtap_tappreferred {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold-tap (tap)";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <155>;
            bindings = <&kp>, <&kp>;
        };
        ht_hp: holdtap_holdpreferred {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold-tap (hold)";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <175>;
            quick-tap-ms = <155>;
            bindings = <&kp>, <&kp>;
        };
        ht_bl: holdtap_balanced {
            compatible = "zmk,behavior-hold-tap";
            display-name = "Hold-tap (balanced)";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <175>;
            quick-tap-ms = <155>;
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
        bt_0: bt_profile_macro_0 {
            display-name = "BT 0";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>
                , <&bt BT_SEL 0>;
        };

        bt_1: bt_profile_macro_1 {
            display-name = "BT 1";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>
                , <&bt BT_SEL 1>;
        };

        bt_2: bt_profile_macro_2 {
            display-name = "BT 2";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>
                , <&bt BT_SEL 2>;
        };

        bt_0_clr: bt_profile_macro_0_clr {
            display-name = "BT 0 clear";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>
                , <&bt BT_SEL 0>
                , <&macro_wait_time 1000>
                , <&bt BT_CLR>;
        };

        bt_1_clr: bt_profile_macro_1_clr {
            display-name = "BT 1 clear";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>
                , <&bt BT_SEL 1>
                , <&macro_wait_time 1000>
                , <&bt BT_CLR>;
        };

        bt_2_clr: bt_profile_macro_2_clr {
            display-name = "BT 2 clear";
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings
                = <&out OUT_BLE>
                , <&bt BT_SEL 2>
                , <&macro_wait_time 1000>
                , <&bt BT_CLR>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <1 2>;
            then-layer = <3>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp ESC     &kp F1  &kp F2    &kp F3    &kp F4      &kp F5                                &kp HOME  &kp END  &kp PG_UP  &kp PG_DN &kp INS    &kp DEL
&kp GRAVE   &kp N1  &kp N2    &kp N3    &kp N4      &kp N5                                &kp N6    &kp N7   &kp N8     &kp N9   &kp N0      &kp BSPC
&kp TAB     &kp Q   &kp W     &kp E     &kp R       &kp T    &kp EQUAL          &kp BSLH  &kp Y     &kp U    &kp I      &kp O    &kp P       &kp ENTER
&mt LGUI MINUS &kp A &kp S    &kp D     &kp F       &kp G    &kp LBKT           &kp HOME  &kp H     &kp J    &kp K      &kp L    &kp SEMI    &kp SQT
&kp LSHFT   &kp Z   &kp X     &kp C     &kp V       &kp B    &kp RBKT           &kp END   &kp N     &kp M    &kp COMMA  &kp DOT  &kp FSLH    &kp RSHFT
                              &none     &kp LALT &lt 2 SPACE &kp LCTRL          &kp ENTER &lt 1 SPACE &lt 1 RALT &kp UP
                    &none     &none     &none                                                       &kp LEFT &kp DOWN   &kp RIGHT
            >;
        };

        lower_layer {
            display-name = "Lower";
            bindings = <
&trans       &trans    &trans    &trans    &trans      &trans                                &bootloader &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans                                &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &trans    &trans   &kp UP     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &kp HOME  &kp LEFT &kp DOWN   &kp RIGHT &trans     &kp PG_UP
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &kp END   &trans   &trans     &trans   &kp BSLH    &kp PG_DN
                                 &trans    &trans      &trans   &trans             &trans    &trans    &trans   &trans
                       &trans    &trans    &trans                                                      &trans   &trans     &trans
            >;
        };

        raise_layer {
            display-name = "Raise";
            bindings = <
&trans       &bt_0_clr &bt_1_clr &bt_2_clr &trans      &bootloader                           &kp F6    &kp F7   &kp F8     &kp F9   &kp F10     &kp F11
&out OUT_USB &bt_0     &bt_1     &bt_2     &trans      &trans                                &trans    &trans   &trans     &trans   &trans      &kp F12
&trans       &trans    &trans    &trans    &trans      &trans   &kp C_VOL_UP       &trans    &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &kp C_VOL_DN       &trans    &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &trans    &trans   &trans     &trans   &trans      &trans
                                 &trans    &trans      &trans   &trans             &trans    &trans    &kp RCTRL &trans
                       &trans    &trans    &trans                                                      &trans   &trans     &trans
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            bindings = <
&studio_unlock       &trans    &trans    &trans    &trans      &trans                                &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans                                &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &trans    &trans   &trans     &trans   &trans      &trans
&trans       &trans    &trans    &trans    &trans      &trans   &trans             &trans    &trans    &trans   &trans     &trans   &trans      &trans
                                 &trans    &trans      &trans   &trans             &trans    &trans    &trans   &trans
                       &trans    &trans    &trans                                                      &trans   &trans     &trans
            >;

        };

        /*
         * Studio 는 devicetree 에 있는 레이어 개수까지만 쓸 수 있고 새로 만들지 못합니다.
         * reserved 레이어는 일반 빌드에서는 완전히 무시되고, Studio 빌드에서만 나타납니다.
         * 반드시 adjust_layer '뒤에' 두세요 - 레이어 ID 가 자식 노드 순서라서
         * 앞에 끼우면 conditional_layers 의 <1 2> -> 3 이 어긋납니다.
         */
        extra1 {
            status = "reserved";
            display-name = "Extra 1";
        };

        extra2 {
            status = "reserved";
            display-name = "Extra 2";
        };

    };
};
