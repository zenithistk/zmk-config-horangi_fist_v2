#include <dt-bindings/zmk/matrix_transform.h>
#include "horangi_fist-layouts.dtsi"

/ {
    chosen {
        zmk,kscan = &kscan0;
        zmk,physical-layout = &horangi_fist_layout;

        /*
         * zmk,matrix_transform 은 여기 두지 않습니다.
         * chosen 에 transform 이 있으면 ZMK 가 physical layout 을 통째로 무시하고
         * ZMK Studio 가 동작하지 않습니다 (app/src/physical_layouts.c:143).
         * transform 은 파일 끝에서 physical layout 에 연결합니다.
         */
    };

    default_transform: keymap_transform_0 {
        compatible = "zmk,matrix-transform";
        columns = <14>;
        rows = <7>;

        map = <
        RC(0,0) RC(0,1) RC(0,2) RC(0,3) RC(0,4) RC(0,5)                    RC(0,8) RC(0,9) RC(0,10) RC(0,11) RC(0,12) RC(0,13)
        RC(1,0) RC(1,1) RC(1,2) RC(1,3) RC(1,4) RC(1,5)                    RC(1,8) RC(1,9) RC(1,10) RC(1,11) RC(1,12) RC(1,13)
        RC(2,0) RC(2,1) RC(2,2) RC(2,3) RC(2,4) RC(2,5) RC(2,6)    RC(2,7) RC(2,8) RC(2,9) RC(2,10) RC(2,11) RC(2,12) RC(2,13)
        RC(3,0) RC(3,1) RC(3,2) RC(3,3) RC(3,4) RC(3,5) RC(3,6)    RC(3,7) RC(3,8) RC(3,9) RC(3,10) RC(3,11) RC(3,12) RC(3,13)
        RC(4,0) RC(4,1) RC(4,2) RC(4,3) RC(4,4) RC(4,5) RC(4,6)    RC(4,7) RC(4,8) RC(4,9) RC(4,10) RC(4,11) RC(4,12) RC(4,13)
                                RC(5,3) RC(5,4) RC(5,5) RC(5,6)    RC(5,7) RC(5,8) RC(5,9) RC(5,10)
                        RC(5,0) RC(5,1) RC(5,2)                                   RC(5,11) RC(5,12) RC(5,13)
        >;
    };

    kscan0: kscan {
        compatible = "zmk,kscan-gpio-matrix";
        wakeup-source;

        diode-direction = "col2row";
        debounce-press-ms = <4>;
        debounce-release-ms = <20>;
    };

};

/* physical layout 에 matrix transform 연결 (chosen 대신) */
&horangi_fist_layout {
    transform = <&default_transform>;
};
